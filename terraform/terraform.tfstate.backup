{
  "version": 4,
  "terraform_version": "1.11.2",
  "serial": 175,
  "lineage": "e3f6d8b5-38f6-9d29-c6dc-bd19af751b30",
  "outputs": {
    "api_identifier": {
      "value": "https://zenobiapay.com",
      "type": "string"
    },
